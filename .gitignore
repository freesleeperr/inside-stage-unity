# This repository is a Unity package, not a Unity project, so none of the usual
# project folders (Library, Temp, Logs, Builds...) are ever generated inside of it.
# What is left is the editor and OS clutter that can still end up here.

# IDE and build tool leftovers
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.user
*.userprefs
*.suo
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Packed package, produced when publishing
*.unitypackage
*.tgz

# OS clutter
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
